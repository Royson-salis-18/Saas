{
  "name": "saas-suite",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "saas-suite",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22.13"
      }
    },
    "apps/dunningdesk": {
      "name": "@saas/dunningdesk",
      "version": "0.1.0",
      "dependencies": {
        "@saas/core": "*"
      }
    },
    "apps/leadrevive": {
      "name": "@saas/leadrevive",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@anthropic-ai/sdk": "^1.3.0",
        "@saas/core": "*"
      }
    },
    "apps/pingpulse": {
      "name": "@saas/pingpulse",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@saas/core": "*"
      }
    },
    "apps/quoteforge": {
      "name": "@saas/quoteforge",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@saas/core": "*"
      }
    },
    "apps/stockwise": {
      "name": "@saas/stockwise",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@saas/core": "*"
      }
    },
    "node_modules/@saas/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@saas/dunningdesk": {
      "resolved": "apps/dunningdesk",
      "link": true
    },
    "packages/core": {
      "name": "@saas/core",
      "version": "0.1.0"
    }
  }
}
