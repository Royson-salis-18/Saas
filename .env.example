# Shared by every product. Each product reads these from its own process environment.
NODE_ENV=production
BASE_URL=https://your-domain.example      # public URL; required for emails/links and secure cookies
PORT=3000
DATA_DIR=./data                           # SQLite files live here (back this folder up)
TRUST_PROXY=1                             # set when behind a reverse proxy (nginx, Caddy, Fly, Render)
SUPPORT_EMAIL=support@your-domain.example
LEGAL_ENTITY=Your Business Name

# Email: "log" records messages only (safe default). "resend" sends via resend.com.
EMAIL_DRIVER=log
RESEND_API_KEY=
EMAIL_FROM=noreply@your-domain.example

# Billing (optional): Stripe for USD, Razorpay for INR. Webhook URLs: /webhooks/stripe, /webhooks/razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LeadRevive only (optional AI drafts)
ANTHROPIC_API_KEY=
LEADREVIVE_MODEL=claude-opus-5-5          # or claude-haiku-5-5 for much lower cost

# PingPulse only: leave unset in production (blocks private/internal targets)
ALLOW_PRIVATE_TARGETS=
