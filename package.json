{
  "name": "saas-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Five small, profitable B2B SaaS products on one zero-dependency Node platform.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"packages/*/test/*.test.js\" \"apps/*/test/*.test.js\"",
    "grant": "node packages/core/bin/grant.js",
    "start:renewalradar": "node apps/renewalradar/server.js"
  }
}
